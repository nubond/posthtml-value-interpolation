{
  "name": "@nubond/posthtml-value-interpolation",
  "description": "nuBond PostHTML plugin for Parcel for value interpolation",
  "author": "Dmytro Tomayly",
  "keywords": ["nuBond", "PostHTML", "Parcel", "value-interpolation"],
  "homepage": "https://github.com/nubond/posthtml-value-interpolation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nubond/posthtml-value-interpolation.git"
  },
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.cjs",
  "module": "src/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/src/index.mjs",
      "require": "./dist/src/index.cjs"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vitest",
    "release": "npx np",
    "build": "unbuild",
    "prepack": "unbuild",
    "lint": "biome lint ./lib ./test",
    "pretest": "npm run lint",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@vitest/coverage-v8": "^3.2.4",
    "posthtml": "^0.16.7",
    "unbuild": "^2.0.0",
    "vitest": "^3.0.8"
  }
}
