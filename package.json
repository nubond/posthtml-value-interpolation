{
  "name": "@nubond/posthtml-value-interpolation",
  "description": "PostHTML plugin for Parcel that compiles mustache-style {{ expression }} templates into nuBond nb-value bindings at build time",
  "author": "Dmytro Tomayly",
  "keywords": [
    "nubond", "posthtml", "posthtml-plugin", "parcel", "parcel-plugin",
    "value-interpolation", "interpolation", "mustache", "template", "nb-value",
    "html", "build-time", "transform"
  ],
  "homepage": "https://github.com/nubond/posthtml-value-interpolation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nubond/posthtml-value-interpolation.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "src/index.cjs",
  "module": "src/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/src/index.mjs",
      "require": "./dist/src/index.cjs"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vitest",
    "release": "npx np",
    "build": "unbuild",
    "prepack": "unbuild",
    "lint": "biome lint ./lib ./test",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@vitest/coverage-v8": "^3.2.4",
    "posthtml": "^0.16.7",
    "unbuild": "^2.0.0",
    "vitest": "^3.0.8"
  }
}
